PORT=10000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase Configuration (Secret / Service Role Key - SERVER ONLY, NEVER expose to frontend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# Optional: Google Gemini API Key for MONO AI Companion (powers deep open-ended guidance)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
